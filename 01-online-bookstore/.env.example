# Environment Configuration for 01-online-bookstore

# Server Configuration
PORT=4001
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1
NEXT_PUBLIC_APP_NAME="Online Bookstore"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://cartly:cartly_secure_password@localhost:5432/cartly_bookstore_db?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-for-bookstore-2026-production-testing"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-bookstore-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Sandbox Configuration
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_SANDBOX_SIMULATE_FAILURES=false

# Storage Configuration (MinIO / S3)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin_secret"
STORAGE_BUCKET="cartly-bookstore-assets"
