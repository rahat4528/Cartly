datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Format {
  HARDCOVER
  PAPERBACK
  DELUXE
  EBOOK
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum MovementReason {
  PURCHASE
  RESTOCK
  DAMAGE_WRITE_OFF
  RETURN
  ADJUSTMENT
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String
  role         Role             @default(CUSTOMER)
  firstName    String
  lastName     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  profile      CustomerProfile?
  cart         Cart?
  wishlist     Wishlist[]
  orders       Order[]
  reviews      Review[]

  @@map("users")
}

model CustomerProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street     String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  phone      String?
  bio        String?
  updatedAt  DateTime @updatedAt

  @@map("customer_profiles")
}

model Author {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  bio         String
  nationality String?
  photoUrl    String?
  birthYear   Int?
  createdAt   DateTime @default(now())
  books       Book[]

  @@map("authors")
}

model Publisher {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  country   String?
  website   String?
  createdAt DateTime @default(now())
  books     Book[]

  @@map("publishers")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  books       Book[]

  @@map("categories")
}

model Book {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  subtitle        String?
  synopsis        String
  authorId        String
  author          Author        @relation(fields: [authorId], references: [id])
  publisherId     String
  publisher       Publisher     @relation(fields: [publisherId], references: [id])
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  language        String        @default("English")
  coverImage      String
  publicationDate DateTime
  featured        Boolean       @default(false)
  isArchived      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  editions        BookEdition[]
  images          BookImage[]
  wishlist        Wishlist[]
  reviews         Review[]

  @@index([authorId])
  @@index([categoryId])
  @@index([title])
  @@map("books")
}

model BookEdition {
  id                 String              @id @default(uuid())
  bookId             String
  book               Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  format             Format              @default(PAPERBACK)
  isbn               String              @unique
  pages              Int
  listPrice          Decimal             @db.Decimal(10, 2)
  salePrice          Decimal             @db.Decimal(10, 2)
  stock              Int                 @default(0)
  sku                String              @unique
  weightGrams        Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([isbn])
  @@map("book_editions")
}

model BookImage {
  id           String @id @default(uuid())
  bookId       String
  book         Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  imageUrl     String
  caption      String?
  displayOrder Int    @default(0)

  @@map("book_images")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String      @id @default(uuid())
  cartId    String
  cart      Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  editionId String
  edition   BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  quantity  Int         @default(1)
  addedAt   DateTime    @default(now())

  @@unique([cartId, editionId])
  @@map("cart_items")
}

model Wishlist {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId  String
  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@unique([userId, bookId])
  @@map("wishlists")
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  discountType   DiscountType @default(PERCENT)
  discountValue  Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal      @default(0.00) @db.Decimal(10, 2)
  maxUses        Int          @default(100)
  usedCount      Int          @default(0)
  expiresAt      DateTime
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@map("coupons")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        Decimal     @db.Decimal(10, 2)
  discountAmount  Decimal     @default(0.00) @db.Decimal(10, 2)
  shippingAmount  Decimal     @default(0.00) @db.Decimal(10, 2)
  taxAmount       Decimal     @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(10, 2)
  shippingAddress Json
  trackingNumber  String?
  couponCode      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  payments        Payment[]
  reviews         Review[]

  @@index([orderNumber])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id             String      @id @default(uuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  editionId      String
  edition        BookEdition @relation(fields: [editionId], references: [id])
  quantity       Int
  unitPrice      Decimal     @db.Decimal(10, 2)
  totalPrice     Decimal     @db.Decimal(10, 2)
  titleSnapshot  String
  formatSnapshot Format
  isbnSnapshot   String

  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String        @default("SANDBOX")
  transactionId  String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())

  @@map("payments")
}

model InventoryMovement {
  id            String         @id @default(uuid())
  editionId     String
  edition       BookEdition    @relation(fields: [editionId], references: [id])
  orderId       String?
  changeAmount  Int
  previousStock Int
  newStock      Int
  reason        MovementReason
  notes         String?
  createdAt     DateTime       @default(now())

  @@index([editionId])
  @@map("inventory_movements")
}

model Review {
  id         String   @id @default(uuid())
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  rating     Int
  title      String
  comment    String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([bookId, userId, orderId])
  @@map("reviews")
}
