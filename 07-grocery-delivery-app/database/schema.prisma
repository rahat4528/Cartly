datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  PICKER_DRIVER
  STORE_ADMIN
}

enum OrderStatus {
  PLACED
  PICKING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum SubstitutionPolicy {
  SUBSTITUTE_BEST_MATCH
  CONTACT_ME
  DO_NOT_SUBSTITUTE
}

enum UnitType {
  EACH
  PER_KG
  PER_LB
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role           @default(CUSTOMER)
  address       String?
  orders        Order[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Product {
  id            String      @id @default(uuid())
  name          String
  slug          String      @unique
  category      String
  description   String
  price         Float
  unitType      UnitType    @default(EACH)
  stockQuantity Int         @default(100)
  imageUrl      String
  aisle         String
  isOrganic     Boolean     @default(false)
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model DeliverySlot {
  id          String   @id @default(uuid())
  slotDate    String   // YYYY-MM-DD
  startTime   String   // e.g. "09:00"
  endTime     String   // e.g. "10:00"
  maxCapacity Int      @default(10)
  bookedCount Int      @default(0)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([slotDate, startTime])
}

model Order {
  id             String       @id @default(uuid())
  orderNumber    String       @unique
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  deliverySlotId String
  deliverySlot   DeliverySlot @relation(fields: [deliverySlotId], references: [id])
  status         OrderStatus  @default(PLACED)
  deliveryAddress String
  contactPhone   String
  deliveryNotes  String?
  subtotal       Float
  deliveryFee    Float        @default(4.99)
  tax            Float
  driverTip      Float        @default(3.00)
  totalAmount    Float
  items          OrderItem[]
  payment        Payment?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model OrderItem {
  id                 String             @id @default(uuid())
  orderId            String
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product            @relation(fields: [productId], references: [id])
  quantity           Int
  unitPrice          Float
  totalPrice         Float
  substitutionPolicy SubstitutionPolicy @default(SUBSTITUTE_BEST_MATCH)
  substitutedWithId  String?
  notes              String?
}

model Subscription {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  frequency        String   // WEEKLY, BI_WEEKLY
  preferredDay     String   // MONDAY, etc.
  preferredSlotTime String  // "09:00-10:00"
  itemsSummary     String
  isActive         Boolean  @default(true)
  nextScheduledAt  DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Payment {
  id             String   @id @default(uuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id])
  amount         Float
  currency       String   @default("USD")
  status         String   // SUCCEEDED, REFUNDED, FAILED
  cardToken      String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
}
