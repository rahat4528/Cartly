# Environment Configuration for 02-progressive-web-app-store

PORT=4002
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3001

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4002/api/v1
NEXT_PUBLIC_APP_NAME="PWA Store"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://cartly:cartly_secure_password@localhost:5433/cartly_pwa_store_db?schema=public"

# Redis Cache & Background Jobs
REDIS_URL="redis://localhost:6380"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-for-pwa-store-2026-production-testing"
JWT_EXPIRES_IN="1d"

# Payment Sandbox Configuration
PAYMENT_SANDBOX_ENABLED=true
